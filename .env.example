# Server only. Copy to .env for npm run dev:api; configure these in Vercel for hosting.
# Rotate any key shared in chat. Never commit a real key.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional alternative: set AI_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_MODEL=

# Web Push: npm run push:keys creates the key pair in the ignored .env file.
# Copy all three values to hosting. Keep the private key on the server only.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=
# At least 32 random characters. Used only for server-to-server cron requests.
CRON_SECRET=
